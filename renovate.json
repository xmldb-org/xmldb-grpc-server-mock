{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:all",
    "schedule:daily"
  ],
  "dependencyDashboard": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchPackagePatterns": [
        "^io\\.quarkus"
      ],
      "groupName": "quarkus dependencies"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "matchDepNames": [
        "com.google.protobuf:protoc"
      ],
      "allowedVersions": "<4.0.0"
    }
  ],
  "schedule": [
    "at any time"
  ]
}
